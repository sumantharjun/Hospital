# Base URL of the Hospital Ecosystem API — no trailing slash.
#   local:      http://localhost:4000
#   production: https://hospital-api.onrender.com
#
# This is the only variable this panel needs. It serves both the REST calls and
# the Socket.IO connection.
#
# NOTE: NEXT_PUBLIC_* values are inlined at BUILD time, not read at runtime.
# Changing it in the Vercel dashboard requires a redeploy to take effect, and
# each environment needs its own build.
NEXT_PUBLIC_API_BASE=http://localhost:4000
