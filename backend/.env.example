# ---------------------------------------------------------------------------
# Hospital Ecosystem API — environment template
# Copy to .env for local development. Set these as real env vars in production.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# MongoDB connection string. Atlas: mongodb+srv://USER:PASS@cluster/hospital
# The server refuses to start without it.
MONGO_URI=

# Signing key for all JWTs. The server refuses to start in production if this
# is unset or left at the old "dev_secret_change_me" default.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Comma-separated browser origins allowed to call the API with credentials.
# Must list every panel origin — this drives both REST CORS and Socket.IO CORS.
# No trailing slashes.
#   https://admin.example.com,https://doctor.example.com,https://reception.example.com,
#   https://nurse.example.com,https://patient.example.com,https://pharmacy.example.com,
#   https://distributor.example.com
# Required in production; in development any localhost origin is also allowed.
ALLOWED_ORIGINS=

# --- Runtime ----------------------------------------------------------------

# Set to "production" on any deployed environment. This enables the JWT_SECRET
# and ALLOWED_ORIGINS start-up guards and disables dev-only OTP.
NODE_ENV=development

# Port the HTTP + WebSocket server listens on.
PORT=4000

# Where uploaded prescriptions/product images are written and served from.
# On a platform with an ephemeral filesystem this MUST point at a mounted
# persistent disk, or uploads are lost on every restart/redeploy.
UPLOAD_DIR=

# --- OTP delivery -----------------------------------------------------------

# OTP login (patient panel, pharmacy staff) sends codes over TextLocal.
# Without TEXT_LOCAL_API_KEY, /otp/send returns 503 in production.
TEXT_LOCAL_API_KEY=
TEXT_LOCAL_SENDER=TXTLCL

# Development escape hatch: print the generated OTP to the server log instead
# of sending an SMS. Ignored when NODE_ENV=production.
ALLOW_DEV_OTP=false

# --- Optional notification channels ----------------------------------------

# Gmail SMTP for email notifications (use an App Password, not the account one).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Twilio WhatsApp notifications.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Expo push notifications.
EXPO_PUSH_TOKEN=
